# ─────────────────────────────────────────────────────────────
# ICT Trading System — Environment Configuration
# Copy this file to .env and fill in your values.
# .env is git-ignored and never committed.
# ─────────────────────────────────────────────────────────────

# IBKR Connection
# TWS Paper : 7497   TWS Live : 7496
# GW  Paper : 4002   GW  Live : 4001
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1

# Risk limits (override defaults in config/settings.py)
RISK_PER_TRADE=0.005     # 0.5% of equity per trade
MAX_DAILY_LOSS=0.03      # 3% daily halt threshold

# Logging verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
